    "ThesisEpisode": {
      "description": "One full thesis cycle for a company.\n\nThe three-layer structure (observations \u2192 inferences \u2192 decisions) mirrors\nhow good analysts actually work: consume raw data, draw conclusions,\nthen act.  Keeping the layers separate makes the reasoning chain\nauditable and reproducible.\n\nRelationship to v0 Episode\n--------------------------\nThesisEpisode is the richer v1 model.  The v0 Episode (legacy.py) is\nstill used by the v0 CLI and store.  They coexist; migration between\nthem is out of scope for v0.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "thesis_statement": {
          "title": "Thesis Statement",
          "type": "string"
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "price_target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Target"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EpisodeStatus",
          "default": "OPEN"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationRecord"
          },
          "title": "Observations",
          "type": "array"
        },
        "inferences": {
          "items": {
            "$ref": "#/$defs/InferenceRecord"
          },
          "title": "Inferences",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionRecord"
          },
          "title": "Decisions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/AssumptionRecord"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/PredictionRecord"
          },
          "title": "Predictions",
          "type": "array"
        },
        "monitoring_triggers": {
          "items": {
            "$ref": "#/$defs/MonitoringTrigger"
          },
          "title": "Monitoring Triggers",
          "type": "array"
        },
